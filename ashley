import pandas as pd
import matplotlib.pyplot as plt

# dataset used
df = pd.read_csv("data/data.csv")

# filtering for illinois
il_data = df[df["State Name"] == "Illinois"]

# grouping by reporting period and calculating average enrollment
il_summary = il_data.groupby("Reporting Period")[["Total Medicaid Enrollment"]].mean().reset_index()

# saving into separate csv
il_summary.to_csv("data/illinois_enrollment.csv", index=False)

# plotting trends in average enrollment over the years
plt.figure(figsize=(10,6))
plt.plot(il_summary["Reporting Period"], il_summary["Total Medicaid Enrollment"], marker="o")
plt.title("Total Medicaid Enrollment in Illinois by Reporting Period")
plt.xlabel("Reporting Period")
plt.ylabel("Total Medicaid Enrollment")
plt.grid(True)
plt.tight_layout()
plt.savefig("data/illinois_enrollment_trend.png")
plt.show()





