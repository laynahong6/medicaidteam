import pandas as pd
import requests

url = "https://www.aha.org/fact-sheets/2025-06-05-medicaid-spending-reductions-would-lead-losses-jobs-economic-activity-and-tax-revenue-states"
html = requests.get(url, headers={"User-Agent": "Mozilla/5.0"}).text
df = pd.read_html(html)[0]
df.to_csv("medicaid_impact.csv", index=False)